# TabuPredict AI - Environment Configuration

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=False
CORS_ORIGINS=["*"]

# File Upload Settings
MAX_UPLOAD_SIZE_MB=10

# ML / TabPFN Settings
# device: 'auto' | 'cpu' | 'cuda' | 'mps'
TABPFN_DEVICE=auto

# Optional PriorLabs / HuggingFace Token for automated weight downloads in headless mode
# TABPFN_TOKEN=your_token_here
TABPFN_NO_BROWSER=1

# Custom cache directory for TabPFN checkpoints (optional)
# TABPFN_MODEL_CACHE_DIR=/path/to/cache
